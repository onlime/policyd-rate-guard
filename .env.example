## PolicydRateGuard configuration, usually /etc/policyd-rate-guard/policyd-rate-guard.env (root:policyd-rate-guard 0640).
## All variables are optional except the database password. See README.md "Configuration".

## Database
# DB_HOST=localhost
# DB_PORT=3306
# DB_UNIX_SOCKET=/run/mysqld/mysqld.sock
DB_USER=policyd
DB_PASSWORD="change-me"
DB_DATABASE=policyd-rate-guard
# DB_POOL_MAXCONNECTIONS=10
# DB_LOCK_WAIT_TIMEOUT=5

## Rate limit
# QUOTA=1000
# ACTION_TEXT_BLOCKED="Rate limit reached, retry later"
# FAIL_ACTION=DUNNO
# How many days to keep rows in the messages table (0: forever)
MESSAGE_RETENTION=365

## Socket: only used without systemd socket activation
# SOCKET="127.0.0.1,10033"

## Logging
# LOG_LEVEL=INFO
LOG_FILE=/var/log/policyd-rate-guard/policyd-rate-guard.log
# LOG_CONSOLE=False
# SYSLOG=False

## Sentry
# SENTRY_DSN=https://**********.ingest.sentry.io/XXXXXXXXXXXXXXXX
# SENTRY_ENVIRONMENT=prod

## Webhook when a sender reaches the quota
# WEBHOOK_ENABLED=True
# WEBHOOK_URL="https://example.com/api/policyd/{sender}"
# WEBHOOK_SECRET="base64 encoded secret, see README.md"
