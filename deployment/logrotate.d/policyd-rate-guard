/var/log/policyd-rate-guard/policyd-rate-guard.log {
	rotate 365
	daily
	dateext
	missingok
	notifempty
	compress
	# keep yesterday's file uncompressed: the daemon may still write a few lines to it before it reopens the log
	delaycompress
	su policyd-rate-guard adm
	create 0640 policyd-rate-guard adm
	# no restart needed: the daemon reopens the file after rotation (WatchedFileHandler)
}
