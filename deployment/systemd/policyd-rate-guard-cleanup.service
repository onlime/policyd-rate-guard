# PolicydRateGuard, recommended setup: see README.md. The Ansible role onlime.policyd_rate_guard installs the same from its templates.
[Unit]
Description=PolicydRateGuard daily cleanup (reset counters and quotas, purge old messages)
Documentation=https://github.com/onlime/policyd-rate-guard
After=network.target mysql.service mariadb.service
# Retried for up to an hour if resetting the counters fails (e.g. a row locked at midnight)
StartLimitIntervalSec=1h
StartLimitBurst=30

[Service]
Type=oneshot
Restart=on-failure
RestartSec=1min
User=policyd-rate-guard
Group=policyd-rate-guard
Environment=POLICYD_ENV_FILE=/etc/policyd-rate-guard/policyd-rate-guard.env
ExecStart=/opt/policyd-rate-guard/venv/bin/policyd-rate-guard cleanup
LogsDirectory=policyd-rate-guard
LogsDirectoryMode=0750
UMask=0027

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
